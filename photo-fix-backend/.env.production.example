# ── Production .env for pixelgraphicstudio.com ──────────────────────────────
# Copy this to `.env` on the LIVE SERVER only (never commit a real .env to
# git). Fill in the ⚠ marked values from your cPanel before first boot.

APP_NAME="Pixel Graphic Studio"
APP_ENV=production
APP_KEY=base64:7JDitNo2yvGt0V4PBFfwHJz22exV1Q9ZFuNkSh0cJSA=
APP_DEBUG=false
APP_URL=https://api.pixelgraphicstudio.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# ⚠ cPanel → MySQL Databases. The DB name/user are usually prefixed with your
# cPanel username, e.g. "cpaneluser_photopixel".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.pixelgraphicstudio.com

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ⚠ cPanel → Email Accounts, create e.g. office@pixelgraphicstudio.com, then
# use its SMTP details here (host is usually mail.pixelgraphicstudio.com).
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=office@pixelgraphicstudio.com
MAIL_FROM_NAME="${APP_NAME}"

# The React frontend's real origin(s) — must match exactly (scheme + host,
# no trailing slash) or the browser will block every API call as CORS-blocked.
FRONTEND_ORIGINS=https://pixelgraphicstudio.com,https://www.pixelgraphicstudio.com
SANCTUM_STATEFUL_DOMAINS=pixelgraphicstudio.com,www.pixelgraphicstudio.com,api.pixelgraphicstudio.com
