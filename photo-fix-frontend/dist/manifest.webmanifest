{
  "name": "Pixel Graphic Studio",
  "short_name": "Pixel Studio",
  "description": "Professional photo editing services — clipping path, retouching, masking, ghost mannequin, background removal and more.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
